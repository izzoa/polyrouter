# dependencies
node_modules/

# build outputs & caches
dist/
.turbo/
coverage/
*.tsbuildinfo
.eslintcache

# logs & OS noise
*.log
.DS_Store

# local env files (never commit secrets)
.env
.env.*
!.env.example

# install.sh install-state sentinels (checkout mode writes these next to .env)
.polyrouter-install
.polyrouter-secrets-created

# per-user agent settings
.claude/settings.local.json

# per-tool skill/command mirrors for agent tools this project doesn't use.
# The only agent config this repo commits is the StyleSeed design skills:
# .agents/skills is the source of truth, and .claude/skills/ss-* symlink into it.
.agent/
.augment/
.crush/
.cursor/
.gemini/
.junie/
.opencode/

# OpenSpec planning workspace (proposals, deltas, archives) — machine-local
openspec/

# OpenSpec-generated agent instructions — `openspec update` re-emits these from
# whichever CLI version is installed, so they belong to the machine, not the repo
# (same reasoning as the workspace above). Run `openspec update` to restore them.
.claude/commands/opsx/
.claude/skills/openspec-*/
.codex/skills/openspec-*/

# design-sync (claude.ai/design): staged converter scripts, regenerated bundle,
# machine-local verification state, and the wrapper's stage-1 compiled output.
# .design-sync/config.json, NOTES.md, conventions.md, previews/, wrapper/src ARE committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/wrapper/solid/

